p_cover":"1920x1080appcoverc40f510d6d5f43fda76042e0ad5fc043","list":"1920x1080list823b2c22c4344831a7e5f42e44410e50","channel_square":"386x3868d881564fd4b4ff6b1bec707abcf2245","channel_list":"360x20316faf51333244b53a489be8b81cccb98","channel_web":"170x120f4620676039d40a6a471c151e052dc17","square":"374x37484c22e753e63400a9a3d42fbd5c57885","tv_cover":"","portrait":"720x1080withlogo298f3320e5704d45b1730648c7ab818c","listclean":"1920x1080listcaeda3e65802494f9f8cb45f6157b474","portraitclean":"","homefeed-launcher-sticker":"1920x457d1f13e9d14c848669a92c37964b8988a","vert_banner":"845x1080ee9db7dc0ca9496ca5448d926660c746","4k_banner":"","hd_tile":"","2x3_hd_poster":"","title_logo":"","tv_banner":"3840x2160tvbannerc2b040cf0a8a46df80b83f33a2216f6f","motion_app_cover":"","motion_cover":"","motion_vert_banner":"","motion_homefeed-launcher-sticker":""},"languages":["hi"],"subtitle_languages":[],"tvod_tier":"","collection_auto_play":null},{"id":"0-9-tvpictureshd","asset_type":9,"title":"&Pictures HD","original_title":"&Pictures HD","business_type":"","genres":[{"id":"Movie","value":"Movie"}],"tags":["& Pictures HD Movies","& Pictures HD Movie Channel","movies","Movie channel","& Pictures HD Channel","& Pictures HD","streamads","cmaf","Premium_Channel"],"list_image":"1920x1080listead02d49416241ce89c60432d7b879a6.png","cover_image":"1920x7708d6cdbd9cf314faeaadda5f380e26e08.png","image":{"cover":"1920x7708d6cdbd9cf314faeaadda5f380e26e08","app_cover":"1920x1080appcover07eb325be36c467ab92fd494a695be4b","list":"1920x1080listead02d49416241ce89c60432d7b879a6","channel_square":"386x386681198410b36448fb8b35d61610f5e07","channel_list":"360x203609bada5c461481caf00837b5fc88692","channel_web":"170x120f4e54151a0a645cba3ae36162b0ca0b1","square":"374x374910e7bd748044e96b044f23d3c5c5873","tv_cover":"","portrait":"720x1080withlogo995db223b15442d9a77072614baaa5c9","listclean":"1920x1080listab6bba98136941a3b52a86b5d67062bd","portraitclean":"1920x54890900609b9be4b45af21557c399b9b7a","homefeed-launcher-sticker":"1920x457f7cba874ff9f41f887be09ccf7d05a73","vert_banner":"845x10808eb725c3753741a5877b88374019580e","4k_banner":"","hd_tile":"","2x3_hd_poster":"2000x3000ae6cca290b5c4831a866e8bbf55ab49e","title_logo":"","tv_banner":"3840x2160tvbanner77602a60bc874a279366669c31e4c1c3","motion_app_cover":"","motion_cover":"","motion_vert_banner":"","motion_homefeed-launcher-sticker":""},"languages":["hi"],"subtitle_languages":[],"tvod_tier":"","collection_auto_play":null},{"id":"0-9-pictures","asset_type":9,"title":"&Pictures","original_title":"&Pictures","business_type":"","genres":[{"id":"Movie","value":"Movie"}],"tags":["Movies Channel","& Pictures","cmaf","Premium_Channel","streamads"],"list_image":"1920x1080liste1864f84ee8f422e9a726e5fe401050c.png","cover_image":"1920x770pwabanner0175cc7f0d294cd585b296d360ac1147.png","image":{"cover":"1920x770pwabanner0175cc7f0d294cd585b296d360ac1147","app_cover":"1920x1080appbanner001286819914416ca03c45c9c3e7ae05","list":"1920x1080liste1864f84ee8f422e9a726e5fe401050c","channel_square":"386x3861db40448c5484e3ab254d3b5f478523b","channel_list":"360x2036af1e5bd11784d5089ee0fa175f2b267","channel_web":"170x1203df9892c205c44c4ba2754d34a27ccdb","square":"374x3742e296cbbc4f54584b3193c4ac38d3cab","tv_cover":"","portrait":"720x1080withlogo97f04968a64e4b7a89c6f2b556b40ea1","listclean":"1920x1080lista5cb40e048824338bd44cb0a54219d2c","portraitclean":"1920x548telco3ea66465c8794db5a4ad6a0ee5c00b6f","homefeed-launcher-sticker":"1920x457bbannera57c0c2c7d2448f39d6abc98db7ebb67","vert_banner":"845x1080verticalbannerd4295ae9246f40e3808878dc98e4cc12","4k_banner":"","hd_tile":"","2x3_hd_poster":"2000x3000appletvhdposter2x3dd93cb61a04448c781999b48a1f63cfe","title_logo":"","tv_banner":"3840x2160tvbanner2913f192d8c44574a3a89f186ac7915e","motion_app_cover":"","motion_cover":"","motion_vert_banner":"","motion_homefeed-launcher-sticker":""},"languages":["hi"],"subtitle_languages":[],"tvod_tier":"","collection_auto_play":null}];
let curCat = 'All', query = '', curId = '', curTitle = '', retryCount = 0;
let hls = null;
const qualitySelector = document.getElementById('qualitySelector');

const getFavs  = () => JSON.parse(localStorage.getItem('zee5favs') || '[]');
const saveFavs = (arr) => localStorage.setItem('zee5favs', JSON.stringify(arr));
let favs = getFavs();

function getGroup(ch) {
  if (ch.genres?.length)    { const g = ch.genres[0];    return typeof g === 'object' ? (g.value || 'General') : g; }
  if (ch.languages?.length) { const l = ch.languages[0]; return typeof l === 'object' ? (l.value || 'General') : l; }
  return 'General';
}
function getLogo(ch) {
  return ch.list_image
    ? `https://akamaividz2.zee5.com/image/upload/w_528,h_297,c_scale,f_webp,q_auto:eco/resources/${ch.id}/list/${ch.list_image}`
    : '';
}
const esc = s => s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const m3u8Url = id => BASE + '/' + encodeURIComponent(id) + '.m3u8';

const cats = ['All', ...new Set(ALL.map(getGroup))].sort((a,b) => a==='All'?-1:b==='All'?1:a.localeCompare(b));
function renderCats() {
  document.getElementById('categories').innerHTML = cats.map(c =>
    `<button class="pill${c===curCat?' active':''}" onclick="setCat('${esc(c)}')">${esc(c)}</button>`
  ).join('');
}
function setCat(c) { curCat = c; renderCats(); renderGrid(); }

function filtered() {
  return ALL.filter(ch => {
    if (query && !(ch.title || '').toLowerCase().includes(query)) return false;
    return curCat === 'All' || getGroup(ch) === curCat;
  });
}

const imageObserver = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      const el = e.target;
      if (el.dataset.src) { el.style.backgroundImage = `url(${el.dataset.src})`; imageObserver.unobserve(el); }
    }
  });
}, { rootMargin: '300px' });

function renderGrid() {
  const items = filtered();
  document.getElementById('channelCount').textContent = items.length;
  const grid = document.getElementById('grid');
  if (!items.length) {
    grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:60px;color:var(--txt2)">No channels found</div>';
    return;
  }
  grid.innerHTML = items.map((ch, i) => {
    const logo  = getLogo(ch);
    const title = esc(ch.title || 'Unknown');
    const genre = esc(getGroup(ch));
    const isFav = favs.includes(ch.id);
    return `<div class="card" style="animation-delay:${Math.min(i*0.02,0.5)}s" onclick="play('${esc(ch.id)}','${esc(ch.title)}')">
      <div class="thumb"${logo ? ` data-src="${logo}"` : ''}>
        <div class="live-badge">LIVE</div>
        <button class="fav-btn" onclick="event.stopPropagation();toggleFav('${esc(ch.id)}')" title="Favorite">${isFav?'❤️':'🤍'}</button>
      </div>
      <div class="info"><h3>${title}</h3><div class="genre">${genre}</div></div>
    </div>`;
  }).join('');
  document.querySelectorAll('.thumb[data-src]').forEach(el => imageObserver.observe(el));
}

function toggleFav(id) {
  favs = favs.includes(id) ? favs.filter(f => f !== id) : [...favs, id];
  saveFavs(favs);
  renderGrid();
}

function changeQuality(val) {
  if (hls) {
    hls.currentLevel = parseInt(val);
  }
}

function populateQualityLevels(levels) {
  qualitySelector.innerHTML = '<option value="-1">Auto</option>';
  levels.forEach((level, idx) => {
    const label = level.height ? `${level.height}p` : `Level ${idx+1}`;
    qualitySelector.innerHTML += `<option value="${idx}">${label}</option>`;
  });
  qualitySelector.style.display = 'inline-block';
}

function startPlayer(src, title) {
  const video = document.getElementById('hlsVideo');
  const loader = document.getElementById('loader');
  const errorMsg = document.getElementById('errorMsg');
  
  loader.classList.remove('hidden');
  errorMsg.classList.remove('show');
  
  if (hls) {
    hls.destroy();
    hls = null;
  }
  
  video.removeAttribute('src');
  video.load();
  qualitySelector.style.display = 'none';
  
  if (Hls.isSupported()) {
    hls = new Hls({
      enableWorker: true,
      lowLatencyMode: true,
      liveSyncDurationCount: 3,
      liveMaxLatencyDurationCount: 10,
      liveDurationInfinity: true,
      backBufferLength: 0,
      maxBufferLength: 30,
      maxMaxBufferLength: 60,
      manifestLoadingTimeOut: 20000,
      manifestLoadingMaxRetry: 4,
      manifestLoadingRetryDelay: 1000,
      levelLoadingTimeOut: 15000,
      levelLoadingMaxRetry: 4,
      levelLoadingRetryDelay: 1000,
      fragLoadingTimeOut: 20000,
      fragLoadingMaxRetry: 6,
      fragLoadingRetryDelay: 1000
    });
    
    hls.loadSource(src);
    hls.attachMedia(video);
    
    hls.on(Hls.Events.MANIFEST_PARSED, (event, data) => {
      loader.classList.add('hidden');
      populateQualityLevels(data.levels);
      video.play().catch(() => {});
    });
    
    hls.on(Hls.Events.ERROR, (event, data) => {
      if (data.fatal) {
        switch (data.type) {
          case Hls.ErrorTypes.NETWORK_ERROR:
            console.error('Fatal network error, retrying...');
            if (retryCount < 2) setTimeout(() => forceRetry(), 1500);
            else showError('Network error – stream may be down.');
            break;
          case Hls.ErrorTypes.MEDIA_ERROR:
            console.error('Fatal media error, recovering...');
            hls.recoverMediaError();
            break;
          default:
            showError('Fatal stream error.');
            break;
        }
      }
    });
    
    hls.on(Hls.Events.LEVEL_LOADED, () => loader.classList.add('hidden'));
    
    video.addEventListener('stalled', () => {
      if (retryCount < 1) setTimeout(() => { if (curId) forceRetry(); }, 15000);
    });
    
  } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
    video.src = src;
    video.addEventListener('loadedmetadata', () => {
      loader.classList.add('hidden');
      video.play().catch(() => {});
    });
    video.addEventListener('error', () => showError('Native HLS error – stream might be blocked.'));
  } else {
    showError('HLS playback not supported in this browser.');
  }
}

function showError(msg) {
  document.getElementById('loader').classList.add('hidden');
  const err = document.getElementById('errorMsg');
  err.classList.add('show');
  document.getElementById('errorText').textContent = msg;
}

function play(id, title) {
  curId = id; curTitle = title; retryCount = 0;
  const src = m3u8Url(id);
  document.getElementById('playerTitle').textContent = title;
  document.getElementById('urlTag').textContent   = src.split('/').pop();
  document.getElementById('urlTag').dataset.url   = src;
  document.getElementById('overlay').classList.add('show');
  document.body.style.overflow = 'hidden';
  startPlayer(src, title);
}

function forceRetry() {
  retryCount++;
  document.getElementById('errorMsg').classList.remove('show');
  document.getElementById('loader').classList.remove('hidden');
  fetch(BASE + '?refresh=' + encodeURIComponent(curId))
    .then(() => { startPlayer(m3u8Url(curId), curTitle); })
    .catch(() => showError('Refresh failed. Try again.'));
}

function closePlayer() {
  if (hls) {
    hls.destroy();
    hls = null;
  }
  const video = document.getElementById('hlsVideo');
  video.pause();
  video.removeAttribute('src');
  video.load();
  qualitySelector.style.display = 'none';
  document.getElementById('overlay').classList.remove('show');
  document.body.style.overflow = '';
}

function copyStreamUrl() {
  const url = document.getElementById('urlTag').dataset.url;
  navigator.clipboard.writeText(url).then(() => toast('Stream URL copied!'));
}

function popOutPlayer() {
  window.open(BASE + '/' + encodeURIComponent(curId) + '.m3u8', '_blank', 'width=800,height=600');
}

function refreshAll() {
  toast('Clearing all caches…');
  fetch(BASE + '?refresh_all').then(() => { toast('Done — reloading.'); setTimeout(() => location.reload(), 800); });
}

let toastTimer;
function toast(msg, dur=3000) {
  clearTimeout(toastTimer);
  document.getElementById('toastMsg').textContent = msg;
  document.getElementById('toast').classList.add('show');
  toastTimer = setTimeout(() => document.getElementById('toast').classList.remove('show'), dur);
}

let searchTimer;
document.getElementById('searchInput').addEventListener('input', e => {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => { query = e.target.value.toLowerCase(); renderGrid(); }, 150);
});

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closePlayer();
  if (e.key === '/' && document.activeElement.tagName !== 'INPUT') { e.preventDefault(); document.getElementById('searchInput').focus(); }
  if (e.key === 'r' && document.getElementById('overlay').classList.contains('show')) forceRetry();
  if (e.key === 'f' && document.getElementById('overlay').classList.contains('show')) {
    const v = document.getElementById('playerWrapper');
    document.fullscreenElement ? document.exitFullscreen() : v.requestFullscreen?.();
  }
});

renderCats();
renderGrid();
toast('ZEE5 PRO v6.1 · ' + ALL.length + ' channels · Resilient HLS Player');
</script>
</body>
</html>