<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#050711">
  <meta name="robots" content="noindex, nofollow">
  <title>Access Restricted • SHOEB</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #050711;
      --panel: rgba(10, 13, 29, 0.82);
      --line: rgba(255, 255, 255, 0.10);
      --text: #f8f9ff;
      --muted: #8f97b4;
      --cyan: #35e7ff;
      --violet: #8b5cf6;
      --pink: #ff2d87;
      --red: #ff466b;
      --green: #55f6b2;
      --mx: 50%;
      --my: 30%;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      min-height: 100%;
      background: var(--bg);
    }

    body {
      min-height: 100svh;
      display: grid;
      place-items: center;
      overflow-x: hidden;
      padding: clamp(18px, 4vw, 48px);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at var(--mx) var(--my), rgba(139, 92, 246, 0.15), transparent 30%),
        radial-gradient(circle at 8% 12%, rgba(53, 231, 255, 0.12), transparent 28%),
        radial-gradient(circle at 92% 88%, rgba(255, 45, 135, 0.12), transparent 30%),
        linear-gradient(145deg, #03040a 0%, #080b18 48%, #04050c 100%);
      position: relative;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.24;
      background-image:
        linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
      background-size: 52px 52px;
      mask-image: radial-gradient(circle at center, black 15%, transparent 82%);
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(transparent 50%, rgba(0,0,0,0.055) 50%);
      background-size: 100% 4px;
      opacity: 0.45;
      z-index: 20;
    }

    .aurora {
      position: fixed;
      width: 42vw;
      height: 42vw;
      min-width: 330px;
      min-height: 330px;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.18;
      pointer-events: none;
      animation: drift 13s ease-in-out infinite alternate;
    }

    .aurora.one {
      left: -18vw;
      top: -20vw;
      background: var(--cyan);
    }

    .aurora.two {
      right: -18vw;
      bottom: -22vw;
      background: var(--pink);
      animation-delay: -6s;
    }

    @keyframes drift {
      to { transform: translate3d(8vw, 7vh, 0) scale(1.16); }
    }

    #particles {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .spark {
      --x: 50%;
      --size: 2px;
      --duration: 12s;
      --delay: 0s;
      position: absolute;
      left: var(--x);
      bottom: -20px;
      width: var(--size);
      height: var(--size);
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 12px currentColor;
      opacity: 0;
      animation: rise var(--duration) linear var(--delay) infinite;
    }

    .spark:nth-child(3n) { color: var(--pink); background: currentColor; }
    .spark:nth-child(4n) { color: var(--violet); background: currentColor; }

    @keyframes rise {
      0% { transform: translate3d(0, 0, 0) scale(0.5); opacity: 0; }
      12% { opacity: 0.75; }
      82% { opacity: 0.25; }
      100% { transform: translate3d(30px, -110vh, 0) scale(1.35); opacity: 0; }
    }

    .shell {
      width: min(980px, 100%);
      position: relative;
      z-index: 2;
      animation: reveal 0.9s cubic-bezier(.18,.89,.32,1.18) both;
    }

    @keyframes reveal {
      from { opacity: 0; transform: translateY(28px) scale(0.975); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin: 0 4px 16px;
    }

    .brand,
    .status {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 38px;
      padding: 8px 14px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(8, 11, 24, 0.68);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      color: #cbd1e8;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .brand-mark {
      width: 22px;
      height: 22px;
      display: grid;
      place-items: center;
      border-radius: 7px;
      color: #061018;
      background: linear-gradient(135deg, var(--cyan), #a7f3ff);
      box-shadow: 0 0 22px rgba(53, 231, 255, 0.45);
      font-size: 0.7rem;
      font-weight: 1000;
    }

    .status {
      color: #ff9cb3;
      border-color: rgba(255, 70, 107, 0.24);
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 0 0 rgba(255, 70, 107, 0.55);
      animation: pulse 1.65s infinite;
    }

    @keyframes pulse {
      70% { box-shadow: 0 0 0 9px rgba(255, 70, 107, 0); }
      100% { box-shadow: 0 0 0 0 rgba(255, 70, 107, 0); }
    }

    .panel {
      position: relative;
      display: grid;
      grid-template-columns: minmax(300px, 0.88fr) minmax(360px, 1.2fr);
      min-height: 570px;
      overflow: hidden;
      border: 1px solid transparent;
      border-radius: 30px;
      background:
        linear-gradient(var(--panel), var(--panel)) padding-box,
        linear-gradient(125deg, rgba(53,231,255,.55), rgba(139,92,246,.20) 38%, rgba(255,45,135,.52)) border-box;
      box-shadow:
        0 40px 100px rgba(0,0,0,.58),
        0 0 80px rgba(139,92,246,.10),
        inset 0 1px 0 rgba(255,255,255,.06);
      backdrop-filter: blur(26px);
      -webkit-backdrop-filter: blur(26px);
    }

    .panel::before {
      content: "";
      position: absolute;
      top: 0;
      left: -45%;
      width: 38%;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--cyan), #fff, var(--pink), transparent);
      box-shadow: 0 0 20px var(--cyan);
      animation: sweep 4.4s ease-in-out infinite;
      z-index: 4;
    }

    @keyframes sweep {
      0%, 12% { left: -45%; }
      72%, 100% { left: 112%; }
    }

    .visual {
      position: relative;
      display: grid;
      place-items: center;
      min-height: 100%;
      padding: 48px 32px;
      overflow: hidden;
      border-right: 1px solid rgba(255,255,255,.065);
      background:
        radial-gradient(circle at 50% 42%, rgba(53,231,255,.12), transparent 32%),
        linear-gradient(160deg, rgba(53,231,255,.035), rgba(139,92,246,.06));
    }

    .visual::before {
      content: "403";
      position: absolute;
      left: 50%;
      bottom: 10px;
      transform: translateX(-50%);
      color: rgba(255,255,255,.025);
      font-size: clamp(8rem, 18vw, 13rem);
      line-height: 1;
      font-weight: 1000;
      letter-spacing: -0.08em;
    }

    .security-stage {
      position: relative;
      width: 246px;
      height: 246px;
      display: grid;
      place-items: center;
    }

    .ring {
      position: absolute;
      inset: 0;
      border: 1px solid rgba(53,231,255,.22);
      border-radius: 50%;
      animation: spin 12s linear infinite;
    }

    .ring::before,
    .ring::after {
      content: "";
      position: absolute;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--cyan);
      box-shadow: 0 0 18px var(--cyan);
    }

    .ring::before { top: 19px; left: 38px; }
    .ring::after { right: 15px; bottom: 50px; background: var(--pink); box-shadow: 0 0 18px var(--pink); }

    .ring.two {
      inset: 20px;
      border-style: dashed;
      border-color: rgba(255,45,135,.23);
      animation-direction: reverse;
      animation-duration: 17s;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .orb {
      width: 150px;
      height: 150px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 42px;
      background:
        linear-gradient(145deg, rgba(255,255,255,.10), rgba(255,255,255,.025)),
        radial-gradient(circle at 30% 20%, rgba(53,231,255,.20), transparent 50%);
      box-shadow:
        0 26px 55px rgba(0,0,0,.44),
        0 0 55px rgba(53,231,255,.14),
        inset 0 1px 0 rgba(255,255,255,.13);
      transform: rotate(45deg);
      animation: breathe 3s ease-in-out infinite;
    }

    @keyframes breathe {
      50% { transform: rotate(45deg) scale(1.045); box-shadow: 0 26px 60px rgba(0,0,0,.5), 0 0 70px rgba(255,45,135,.18); }
    }

    .orb svg {
      width: 78px;
      height: 78px;
      transform: rotate(-45deg);
      filter: drop-shadow(0 0 18px rgba(53,231,255,.42));
    }

    .visual-label {
      position: absolute;
      left: 50%;
      bottom: 54px;
      transform: translateX(-50%);
      width: max-content;
      text-align: center;
    }

    .visual-label strong {
      display: block;
      color: #eefcff;
      font-size: .82rem;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    .visual-label span {
      display: block;
      margin-top: 7px;
      color: var(--muted);
      font-size: .72rem;
      letter-spacing: .06em;
    }

    .content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(32px, 5vw, 62px);
      position: relative;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 18px;
      color: var(--cyan);
      font-size: .72rem;
      font-weight: 900;
      letter-spacing: .18em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 28px;
      height: 1px;
      background: var(--cyan);
      box-shadow: 0 0 10px var(--cyan);
    }

    h1 {
      max-width: 600px;
      font-size: clamp(2.25rem, 5.2vw, 4.45rem);
      line-height: .96;
      letter-spacing: -.055em;
      font-weight: 950;
    }

    h1 span {
      display: block;
      color: transparent;
      background: linear-gradient(100deg, var(--cyan), #b8a4ff 48%, var(--pink));
      -webkit-background-clip: text;
      background-clip: text;
      filter: drop-shadow(0 0 22px rgba(139,92,246,.18));
    }

    .lead {
      max-width: 560px;
      margin-top: 20px;
      color: var(--muted);
      font-size: .96rem;
      line-height: 1.75;
    }

    .lead strong { color: #eef2ff; }

    .owner-card {
      position: relative;
      display: grid;
      grid-template-columns: 54px 1fr auto;
      align-items: center;
      gap: 15px;
      margin-top: 24px;
      padding: 15px 16px;
      overflow: hidden;
      border: 1px solid rgba(139,92,246,.28);
      border-radius: 18px;
      background:
        linear-gradient(110deg, rgba(139,92,246,.12), rgba(255,45,135,.07)),
        rgba(255,255,255,.025);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.06);
    }

    .owner-card::before {
      content: "";
      position: absolute;
      inset: -100% auto -100% -30%;
      width: 18%;
      transform: rotate(18deg);
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.22), transparent);
      animation: shine 4.8s ease-in-out infinite;
    }

    @keyframes shine {
      0%, 22% { left: -35%; }
      72%, 100% { left: 130%; }
    }

    .owner-avatar {
      width: 54px;
      height: 54px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(53,231,255,.32);
      border-radius: 16px;
      color: #061019;
      background: linear-gradient(135deg, var(--cyan), #a7f3ff 48%, #d6c8ff);
      box-shadow: 0 0 28px rgba(53,231,255,.20);
      font-size: 1.45rem;
      font-weight: 1000;
    }

    .owner-meta small {
      display: block;
      margin-bottom: 2px;
      color: #949dbd;
      font-size: .58rem;
      font-weight: 900;
      letter-spacing: .17em;
      text-transform: uppercase;
    }

    .owner-name {
      position: relative;
      width: fit-content;
      color: #fff;
      font-size: clamp(1.55rem, 3vw, 2.15rem);
      line-height: 1;
      font-weight: 1000;
      letter-spacing: .08em;
      text-shadow: 0 0 18px rgba(53,231,255,.28), 0 0 30px rgba(255,45,135,.22);
      isolation: isolate;
    }

    .owner-name::before,
    .owner-name::after {
      content: attr(data-text);
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: .45;
      z-index: -1;
    }

    .owner-name::before {
      color: var(--cyan);
      animation: glitch-a 3.2s steps(1) infinite;
    }

    .owner-name::after {
      color: var(--pink);
      animation: glitch-b 3.2s steps(1) infinite;
    }

    @keyframes glitch-a {
      0%, 89%, 100% { transform: translate(0); clip-path: inset(0 0 0 0); }
      90% { transform: translate(-3px, 1px); clip-path: inset(10% 0 62% 0); }
      93% { transform: translate(2px, -1px); clip-path: inset(67% 0 8% 0); }
      96% { transform: translate(0); }
    }

    @keyframes glitch-b {
      0%, 87%, 100% { transform: translate(0); clip-path: inset(0 0 0 0); }
      88% { transform: translate(3px, -1px); clip-path: inset(55% 0 18% 0); }
      92% { transform: translate(-2px, 1px); clip-path: inset(16% 0 60% 0); }
      95% { transform: translate(0); }
    }

    .owner-meta p {
      margin-top: 5px;
      color: #858fac;
      font-size: .72rem;
    }

    .verified {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 6px 9px;
      border: 1px solid rgba(85,246,178,.20);
      border-radius: 999px;
      color: var(--green);
      background: rgba(85,246,178,.07);
      font-size: .6rem;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .verified::before {
      content: "✓";
      width: 14px;
      height: 14px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: #05110d;
      background: var(--green);
      font-size: .58rem;
    }

    .url-instruction {
      display: grid;
      grid-template-columns: 48px 1fr;
      align-items: center;
      gap: 14px;
      margin-top: 22px;
      padding: 16px 17px;
      border: 1px solid rgba(53,231,255,.22);
      border-radius: 17px;
      background:
        linear-gradient(110deg, rgba(53,231,255,.09), rgba(139,92,246,.08)),
        rgba(255,255,255,.025);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.06), 0 15px 36px rgba(0,0,0,.18);
    }

    .instruction-icon {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(53,231,255,.28);
      border-radius: 14px;
      color: var(--cyan);
      background: rgba(53,231,255,.08);
      box-shadow: 0 0 24px rgba(53,231,255,.12);
      font-size: 1.35rem;
      font-weight: 950;
    }

    .url-instruction strong {
      display: block;
      margin-bottom: 5px;
      color: #f2fbff;
      font-size: .78rem;
      font-weight: 950;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .url-instruction p {
      color: #aab3cf;
      font-size: .83rem;
      line-height: 1.55;
    }

    .url-instruction em {
      color: var(--cyan);
      font-style: normal;
      font-weight: 850;
    }

    .foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin: 16px 5px 0;
      color: #606982;
      font-size: .65rem;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .foot strong {
      color: #a8b0c8;
      font-weight: 800;
    }

    @media (max-width: 780px) {
      body { padding: 16px; place-items: start center; }
      .shell { margin: auto 0; }
      .topbar { margin-bottom: 12px; }
      .brand, .status { padding: 7px 10px; font-size: .6rem; }
      .panel { grid-template-columns: 1fr; border-radius: 24px; }
      .visual {
        min-height: 270px;
        padding: 25px;
        border-right: 0;
        border-bottom: 1px solid rgba(255,255,255,.065);
      }
      .security-stage { width: 190px; height: 190px; }
      .orb { width: 118px; height: 118px; border-radius: 34px; }
      .orb svg { width: 61px; height: 61px; }
      .visual-label { bottom: 22px; }
      .content { padding: 31px 22px 27px; }
      h1 { font-size: clamp(2.35rem, 13vw, 3.6rem); }
      .lead { margin-top: 16px; font-size: .88rem; }
      .owner-card { grid-template-columns: 48px 1fr; }
      .owner-avatar { width: 48px; height: 48px; border-radius: 14px; }
      .verified { grid-column: 1 / -1; width: fit-content; }
      .url-instruction { grid-template-columns: 44px 1fr; padding: 14px; }
      .instruction-icon { width: 44px; height: 44px; }
      .foot { align-items: flex-start; flex-direction: column; gap: 6px; }
    }

    @media (max-width: 430px) {
      .brand .brand-text { display: none; }
      .status { letter-spacing: .08em; }
      .visual { min-height: 240px; }
      .security-stage { transform: scale(.88); }
      .owner-name { font-size: 1.55rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
      }
    }
  </style>
</head>
<body>
  <div class="aurora one"></div>
  <div class="aurora two"></div>
  <div id="particles" aria-hidden="true"></div>

  <main class="shell">
    <header class="topbar">
      <div class="brand">
        <span class="brand-mark">P</span>
        <span class="brand-text">Premium Plug • Secure Gateway</span>
      </div>
      <div class="status">
        <span class="status-dot"></span>
        Request blocked
      </div>
    </header>

    <section class="panel">
      <div class="visual" aria-hidden="true">
        <div class="security-stage">
          <div class="ring"></div>
          <div class="ring two"></div>
          <div class="orb">
            <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M48 8 78 20v23c0 21-12.6 37.4-30 45C30.6 80.4 18 64 18 43V20L48 8Z" fill="url(#shield)" stroke="rgba(255,255,255,.52)" stroke-width="2"/>
              <path d="M38 45v-6c0-6 4.2-11 10-11s10 5 10 11v6" stroke="#EAFDFF" stroke-width="5" stroke-linecap="round"/>
              <rect x="32" y="43" width="32" height="25" rx="7" fill="#071522" stroke="#35E7FF" stroke-width="2"/>
              <circle cx="48" cy="55" r="3.5" fill="#FF2D87"/>
              <path d="M48 58.5V63" stroke="#FF2D87" stroke-width="3" stroke-linecap="round"/>
              <defs>
                <linearGradient id="shield" x1="18" y1="8" x2="83" y2="80" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#35E7FF"/>
                  <stop offset=".48" stop-color="#8B5CF6"/>
                  <stop offset="1" stop-color="#FF2D87"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
        <div class="visual-label">
          <strong>Security Protocol Active</strong>
          <span>HTTP 403 • Browser signature detected</span>
        </div>
      </div>

      <div class="content">
        <div class="eyebrow">Protected playlist</div>
        <h1>Browser access <span>restricted.</span></h1>
        <p class="lead">
          This gateway accepts <strong>authorized IPTV player requests only.</strong>
          Browser mein playlist open nahi hogi—ise OTT Navigator mein use karo.
        </p>

        <div class="owner-card">
          <div class="owner-avatar">S</div>
          <div class="owner-meta">
            <small>Owner &amp; Developer</small>
            <div class="owner-name" data-text="SHOEB">SHOEB</div>
            <p>Premium Plug Command • Verified access system</p>
          </div>
          <span class="verified">Verified</span>
        </div>

        <div class="url-instruction">
          <div class="instruction-icon">↗</div>
          <div>
            <strong>OTT Navigator mein open karo</strong>
            <p>OTT Navigator mein ye URL open karo: <em>https://jio.shoeblivesite.dpdns.org/</em></p>
          </div>
        </div>
      </div>
    </section>

    <footer class="foot">
      <span>Encrypted gateway • Unauthorized browser request denied</span>
      <strong>Protected by SHOEB</strong>
    </footer>
  </main>

  <script>
    (function () {
      var particles = document.getElementById('particles');
      for (var i = 0; i < 34; i += 1) {
        var spark = document.createElement('span');
        spark.className = 'spark';
        spark.style.setProperty('--x', (Math.random() * 100).toFixed(2) + '%');
        spark.style.setProperty('--size', (Math.random() * 2.7 + 1).toFixed(1) + 'px');
        spark.style.setProperty('--duration', (Math.random() * 11 + 9).toFixed(1) + 's');
        spark.style.setProperty('--delay', (-Math.random() * 18).toFixed(1) + 's');
        particles.appendChild(spark);
      }

      document.addEventListener('pointermove', function (event) {
        document.documentElement.style.setProperty('--mx', ((event.clientX / window.innerWidth) * 100).toFixed(1) + '%');
        document.documentElement.style.setProperty('--my', ((event.clientY / window.innerHeight) * 100).toFixed(1) + '%');
      }, { passive: true });

      document.addEventListener('contextmenu', function (event) {
        event.preventDefault();
      });
    }());
  </script>
</body>
