<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login — STREAMXYASH</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <div class="wrap narrow">
    <div class="brand"><span class="dot"></span> STREAMXYASH · Admin</div>
    <div class="card center-card" style="padding: 30px 26px;">
      <h1 style="margin-bottom: 4px;">Admin sign in</h1>
      <p class="sub">Manage the playlist source, renewal link, and users.</p>
      
      <form method="POST" action="/admin/login" style="text-align: left;">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" autocomplete="username" required>
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
        <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 6px;">Sign in</button>
      </form>
    </div>
  </div>
</body>
</html>
