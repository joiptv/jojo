<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ZEE5 PRO · Live TV</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
<style>
/* ... (the entire CSS from your original script – unchanged) ... */
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#090912;--surface:rgba(255,255,255,.03);--surface2:rgba(255,255,255,.06);
  --border:rgba(255,255,255,.06);--border-focus:rgba(0,210,255,.35);
  --txt:#fff;--txt2:rgba(255,255,255,.55);--txt3:rgba(255,255,255,.3);
  --accent:#00c6ff;--accent2:#a855f7;--glow:0 0 20px rgba(0,210,255,.15);
  --radius:18px;--radius-sm:12px;--transition:cubic-bezier(0.2,0,0,1);
}
html{scroll-behavior:smooth}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--txt);min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(circle at 20% 30%,rgba(120,0,255,.08),transparent 50%),radial-gradient(circle at 80% 70%,rgba(0,210,255,.06),transparent 50%);z-index:0;pointer-events:none}
.container{max-width:1440px;margin:0 auto;padding:0 20px;position:relative;z-index:1}
header{position:sticky;top:0;z-index:100;background:rgba(9,9,18,.8);backdrop-filter:blur(24px);border-bottom:1px solid var(--border);padding:12px 0}
header .container{display:flex;align-items:center;gap:20px}
.logo{font-size:1.8rem;font-weight:800;background:linear-gradient(135deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;user-select:none}
.logo span{font-size:.7rem;font-weight:600;opacity:.5;-webkit-text-fill-color:var(--txt2);margin-left:4px;vertical-align:super}
.search-box{flex:1;max-width:420px;position:relative}
.search-box svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--txt3);width:18px;height:18px}
.search-box input{width:100%;padding:10px 16px 10px 44px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--txt);font-size:.9rem;outline:none;transition:all .25s var(--transition)}
.search-box input:focus{border-color:var(--accent);box-shadow:var(--glow);background:rgba(255,255,255,.08)}
.stats{display:flex;align-items:center;gap:12px;color:var(--txt3);font-size:.8rem;font-weight:500;flex-shrink:0}
.stats .dot{width:7px;height:7px;border-radius:50%;background:#22c55e;display:inline-block;margin-right:4px;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:var(--radius-sm);border:1px solid var(--border);background:rgba(255,255,255,.04);color:var(--txt);font-size:.8rem;font-weight:500;cursor:pointer;transition:all .2s var(--transition);text-decoration:none;white-space:nowrap}
.btn:hover{background:rgba(255,255,255,.1);border-color:var(--border-focus)}
.btn-accent{background:linear-gradient(135deg,rgba(0,210,255,.15),rgba(168,85,247,.12));border-color:rgba(0,210,255,.3)}
.btn svg{width:16px;height:16px}
.categories{display:flex;gap:8px;overflow-x:auto;padding:12px 0;scrollbar-width:none;mask-image:linear-gradient(90deg,transparent,#000 30px,#000 calc(100%-30px),transparent)}
.categories::-webkit-scrollbar{display:none}
.pill{padding:6px 16px;border-radius:20px;border:1px solid var(--border);background:transparent;color:var(--txt2);font-size:.75rem;font-weight:500;white-space:nowrap;cursor:pointer;transition:all .2s var(--transition);font-family:inherit}
.pill:hover{background:rgba(255,255,255,.06)}
.pill.active{background:linear-gradient(135deg,var(--accent),var(--accent2));color:#fff;border-color:transparent;box-shadow:var(--glow)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;padding:12px 0 40px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;cursor:pointer;transition:transform .3s var(--transition),box-shadow .3s,border-color .3s;animation:cardIn .4s ease both;position:relative}
@keyframes cardIn{from{opacity:0;transform:translateY(20px)}}
.card:hover{transform:translateY(-4px);border-color:var(--border-focus);box-shadow:var(--glow);background:var(--surface2)}
.thumb{aspect-ratio:16/9;background-size:cover;background-position:center;background-color:#1a1a2e;position:relative}
.thumb::after{content:'';position:absolute;bottom:0;left:0;right:0;height:50%;background:linear-gradient(to top,rgba(0,0,0,.7),transparent)}
.thumb .live-badge{position:absolute;top:10px;left:10px;padding:3px 8px;background:rgba(34,197,94,.9);color:#fff;font-size:.65rem;font-weight:700;border-radius:4px;display:flex;align-items:center;gap:4px;z-index:2}
.live-badge::before{content:'';width:5px;height:5px;background:#fff;border-radius:50%;animation:blink 1.4s infinite}
@keyframes blink{50%{opacity:0}}
.card .info{padding:12px 14px}
.card h3{font-size:.9rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .genre{font-size:.75rem;color:var(--txt3);margin-top:2px}
.card .fav-btn{position:absolute;top:10px;right:10px;z-index:5;background:rgba(0,0,0,.5);border:none;color:#fff;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;opacity:0;transition:opacity .2s}
.card:hover .fav-btn{opacity:1}
.overlay{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.95);display:none;flex-direction:column;align-items:center;justify-content:center;backdrop-filter:blur(12px)}
.overlay.show{display:flex}
.overlay-header{position:absolute;top:0;left:0;right:0;padding:14px 24px;display:flex;align-items:center;gap:14px;z-index:10}
.back-btn{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;padding:8px 14px;border-radius:8px;cursor:pointer;font-weight:600;font-size:.85rem;display:flex;align-items:center;gap:6px;transition:background .2s}
.back-btn:hover{background:rgba(255,255,255,.2)}
.channel-title{font-size:1.1rem;font-weight:600;opacity:.9}
.overlay-actions{margin-left:auto;display:flex;gap:8px}
.url-tag{font-size:.7rem;color:var(--txt3);background:rgba(255,255,255,.06);padding:4px 10px;border-radius:6px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer}
.url-tag:hover{color:var(--accent)}
.player-wrapper{width:80vw;max-width:1000px;aspect-ratio:16/9;max-height:80vh;border-radius:16px;overflow:hidden;box-shadow:0 0 40px rgba(0,0,0,.6);background:#000;position:relative}
.player-wrapper video{width:100%;height:100%;object-fit:contain}
.loader{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:rgba(0,0,0,.7);z-index:5}
.loader.hidden{display:none}
.spinner{width:40px;height:40px;border:3px solid rgba(255,255,255,.1);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.error-msg{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:rgba(0,0,0,.8);z-index:6}
.error-msg.show{display:flex}
.error-msg h3{color:#ef4444}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(100px);background:rgba(20,20,40,.9);backdrop-filter:blur(12px);border:1px solid var(--border);border-radius:12px;padding:12px 24px;color:var(--txt);font-size:.85rem;z-index:999;transition:transform .3s var(--transition);display:flex;align-items:center;gap:8px}
.toast.show{transform:translateX(-50%) translateY(0)}
.toast .dot{width:8px;height:8px;border-radius:50%;background:var(--accent)}
#qualitySelector {
  background: rgba(255,255,255,.06); border:1px solid var(--border); border-radius:6px;
  color: var(--txt); padding: 4px 8px; font-size: .8rem; outline: none;
  cursor: pointer; display: none;
}
@media(max-width:768px){
  .player-wrapper{width:95vw;max-height:60vh}
  .grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px}
  .card h3{font-size:.8rem}
  header .container{gap:10px}
  .search-box{max-width:200px}
}
</style>
</head>
<body>
<div class="container" style="padding-top:0">
  <header><div class="container">
    <div class="logo">ZEE5<span>PRO</span></div>
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input id="searchInput" type="text" placeholder="Search channels…" autocomplete="off">
    </div>
    <div class="stats"><span class="dot"></span><span id="channelCount">114</span> live</div>
    <a class="btn btn-accent" href="?m3u" download>📥 M3U</a>
    <button class="btn" onclick="refreshAll()" title="Refresh all channels and playlists">🔄</button>
  </div></header>

  <div class="categories" id="categories"></div>
  <div class="grid" id="grid"></div>
</div>

<div class="overlay" id="overlay">
  <div class="overlay-header">
    <button class="back-btn" onclick="closePlayer()">← Back</button>
    <div class="channel-title" id="playerTitle">Channel</div>
    <div class="overlay-actions">
      <span class="url-tag" id="urlTag" onclick="copyStreamUrl()" title="Copy stream URL"></span>
      <select id="qualitySelector" onchange="changeQuality(this.value)">
        <option value="-1">Auto</option>
      </select>
      <button class="btn" id="retryBtn" onclick="forceRetry()" title="Force refresh stream">↻ Retry</button>
      <button class="btn" onclick="popOutPlayer()" title="Open in new window">🔗 Pop-out</button>
    </div>
  </div>
  <div class="player-wrapper" id="playerWrapper">
    <div class="loader" id="loader"><div class="spinner"></div><p id="loaderMsg">Loading stream…</p></div>
    <div class="error-msg" id="errorMsg">
      <h3>Stream Error</h3>
      <p id="errorText">Channel unavailable.</p>
      <button class="btn" onclick="forceRetry()">↻ Force Retry</button>
    </div>
    <video id="hlsVideo" playsinline autoplay muted controls style="width:100%;height:100%"></video>
  </div>
</div>

<div class="toast" id="toast"><span class="dot"></span><span id="toastMsg"></span></div>

