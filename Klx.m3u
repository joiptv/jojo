#EXTM3U url-tvg="https://avkb.short.gy/jioepg.xml.gz"

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>404 - Not Found</title>

<style>
* {
margin: 0;
padding: 0;
box-sizing: border-box;
font-family: 'Poppins', sans-serif;
}

body {
height: 100vh;
background: #0f0f0f;
color: #fff;
display: flex;
align-items: center;
justify-content: center;
overflow: hidden;
}

.container {
text-align: center;
}

h1 {
font-size: 120px;
background: linear-gradient(45deg, #6a5cff, #00c6ff);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
}

p {
font-size: 18px;
color: #aaa;
margin-top: 10px;
}

a {
display: inline-block;
margin-top: 30px;
padding: 12px 25px;
border-radius: 30px;
background: linear-gradient(45deg, #6a5cff, #00c6ff);
color: #fff;
text-decoration: none;
transition: 0.3s;
}

a:hover {
transform: scale(1.1);
box-shadow: 0 0 20px rgba(106,92,255,0.6);
}

/* Floating animation */
.circle {
position: absolute;
border-radius: 50%;
background: rgba(106,92,255,0.1);
animation: float 6s infinite ease-in-out;
}

.circle:nth-child(1) {
width: 200px;
height: 200px;
top: 10%;
left: 15%;
}

.circle:nth-child(2) {
width: 300px;
height: 300px;
bottom: 10%;
right: 15%;
}

@keyframes float {
0%,100% { transform: translateY(0px); }
50% { transform: translateY(-30px); }
}
</style>
</head>

<body>

<div class="circle"></div>
<div class="circle"></div>

<div class="container">
<h1>404</h1>
<p>Page not found</p>
<a href="/">Go Home</a>
</div>

</body>
</html>