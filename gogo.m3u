
    <!DOCTYPE html>
    <html lang="hi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Timepass Machine 2.0</title>
        <style>
            body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #121212; color: white; text-align: center; padding: 50px; }
            .container { background: #1e1e1e; padding: 30px; border-radius: 15px; box-shadow: 0 0 20px #ff0055; display: inline-block; max-width: 500px; }
            h1 { color: #ff0055; }
            .content { font-size: 1.5rem; margin: 20px 0; min-height: 100px; color: #00ffcc; }
            button { background: #ff0055; color: white; border: none; padding: 15px 30px; font-size: 1rem; border-radius: 5px; cursor: pointer; transition: 0.3s; }
            button:hover { background: #ff5588; transform: scale(1.05); }
            .footer { margin-top: 30px; font-size: 0.8rem; color: #666; }
        </style>
    </head>
    <body>
        <div class="container">
            <h1>Desi Timepass Machine 🚀</h1>
            <div id="box" class="content">"Click below to waste 2 seconds of your life"</div>
            <button onclick="generate()">Kuch Timepass Karo</button>
            <div class="footer">Created for No Reason At All</div>
        </div>

        <script>
            const data = [
                "Mummy: 'Saara din phone mein ghusa rehta hai, aag laga de is phone ko!'",
                "Fact: Maggi kabhi 2 minute mein nahi banti.",
                "Future: Agle 5 minute mein aapko pyaas lagne waali hai.",
                "Mummy: 'Padosi ke ladke ko dekh, 95% laya hai. Tu bas worker hi banata reh!'",
                "Fact: 'Jio' ka ulta 'Oil' hota hai. Socho is baare mein.",
                "Future: Aapki shaadi mein bohot baarish hogi (Agar hui toh).",
                "Mummy: 'So ja ab, subah 10 baje tak kaun sota hai?'",
                "Fact: Cockroach sar katne ke baad bhi 9 din tak zinda reh sakta hai.",
                "Advice: Engineering kar li? Ab thoda coding bhi sikh lo beta.",
                "Future: Aapka boss aapko kal extra kaam dene wala hai.",
                "Mummy: 'Bahut paise kama raha hai? Sab kharch kar deta hai bahar ke khaane mein!'"
            ];

            function generate() {
                const box = document.getElementById('box');
                const random = data[Math.floor(Math.random() * data.length)];
                box.style.opacity = 0;
                setTimeout(() => {
                    box.innerText = random;
                    box.style.opacity = 1;
                }, 200);
            }
        </script>
    </body>
    </html>
    