      <span class="signal-meter lvl-0" style="height:36px; gap:5px; margin-bottom:16px;">
        <span class="bar" style="width:7px;"></span><span class="bar" style="width:7px;"></span><span class="bar" style="width:7px;"></span><span class="bar" style="width:7px;"></span><span class="bar" style="width:7px;"></span>
      </span>
